# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# Your Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=paste-your-key-here

# Main model. Check limits per model in Google AI Studio (Usage / Rate limits).
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: second model to use if the main one stays unavailable. Leave empty for none.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Max requests per minute per model. Keep it a bit below the model's RPM limit
# (free tier Flash Lite: 15/min), so requests are spaced out instead of failing with 429.
GEMINI_RPM=12

# Optional: model used as judge in evaluate.py. Defaults to GEMINI_MODEL.
# JUDGE_MODEL=
